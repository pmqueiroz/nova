---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}

const { title, description, type = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const ogAlt = 'Nova: a GPU-accelerated terminal where every command is a block';
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nova',
  url: new URL('/', Astro.site).href,
};
const graph = [site, ...jsonLd.map((d) => ({ '@context': 'https://schema.org', ...d }))];
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta name="author" content="pmqueiroz" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0c1015" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f9fafc" media="(prefers-color-scheme: light)" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Nova" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={ogAlt} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
<script is:inline>
(()=>{try{const t=new URLSearchParams(location.search).get('theme')||localStorage.getItem('nova-site-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}})();
</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X9WTDL262N"></script>
<script is:inline>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-X9WTDL262N');
</script>
<slot name="head" />
</head>
<body>
<slot />
<script>
import '../scripts/site.js';
</script>
</body>
</html>
